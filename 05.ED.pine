//@version=6
indicator("Net Debt to EBITDA", shorttitle="Debt/EBITDA", overlay=false, precision=2)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
s_in = input.string("Auto", "Sector", options=["Auto", "Tecnologia", "Bancos", "General", "Custom"])
c_l = input.float(2.0, "Sólido (Máx)")
c_h = input.float(4.0, "Riesgo (Min)")
s_tab = input.bool(true, "Mostrar Tabla")

// ─── DATA (CON AUTO-RELLENO DE HUECOS) ────────────────────────────────────────
// Pedimos Deuda Neta y EBITDA
nd_ttm = request.financial(syminfo.tickerid, "NET_DEBT", "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
eb_ttm = request.financial(syminfo.tickerid, "EBITDA",   "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

nd_fy  = request.financial(syminfo.tickerid, "NET_DEBT", "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
eb_fy  = request.financial(syminfo.tickerid, "EBITDA",   "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

// Consolidamos
nd = not na(nd_ttm) ? nd_ttm : nd_fy
eb = not na(eb_ttm) ? eb_ttm : eb_fy

// Cálculo del Ratio (Deuda / EBITDA)
// Ref: < 2 Sólido, 2-4 Manejable, > 4 Riesgo
ratio = (not na(nd) and not na(eb) and eb > 0) ? nd / eb : na

// ─── SECTOR Y RANGOS ──────────────────────────────────────────────────────────
// El sector financiero (Bancos) se analiza distinto, pero para corporativas:
is_tech = syminfo.sector == "Technology Services" or syminfo.sector == "Electronic Technology"
auto_sec = is_tech ? "Tecnologia" : "General"
sec = s_in == "Auto" ? auto_sec : s_in

r_l = sec == "Custom" ? c_l : 2.0
r_h = sec == "Custom" ? c_h : 4.0

// ─── VISUALS ──────────────────────────────────────────────────────────────────
// En deuda, MENOS es MEJOR (Verde abajo, Rojo arriba)
c_ratio = na(ratio) ? color.gray : ratio < r_l ? color.green : ratio <= r_h ? color.orange : color.red

plot(r_l, "Límite Sólido", color=color.new(color.green, 50), style=plot.style_stepline)
plot(r_h, "Límite Riesgo", color=color.new(color.red, 50),   style=plot.style_stepline)
plot(ratio, "Debt/EBITDA", color=c_ratio, linewidth=3,      style=plot.style_stepline)

fill(plot(r_l, display=display.none), plot(r_h, display=display.none), color=color.new(color.orange, 92))
hline(0, "Cero", color=color.gray, linestyle=hline.style_dotted)

// ─── TABLA INFORMATIVA ────────────────────────────────────────────────────────
if s_tab and barstate.islast
    var table t = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.gray)
    h_bg = color.new(color.blue, 40)
    
    // Fila 0 - Ratio
    table.cell(t, 0, 0, "Debt / EBITDA", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, na(ratio) ? "N/D" : str.tostring(ratio, "#.##"), text_color=c_ratio, text_size=size.small)
    
    // Fila 1 - Estado
    status = na(ratio) ? "N/D" : ratio < r_l ? "Sólido" : ratio <= r_h ? "Manejable" : "RIESGO"
    table.cell(t, 0, 1, "Estado", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, status, text_color=c_ratio, text_size=size.small)
    
    // Fila 2 - Deuda Neta
    table.cell(t, 0, 2, "Net Debt", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, na(nd) ? "N/D" : str.tostring(nd/1e6, "#") + "M", text_color=color.white, text_size=size.small)
    
    // Fila 3 - EBITDA
    table.cell(t, 0, 3, "EBITDA", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, na(eb) ? "N/D" : str.tostring(eb/1e6, "#") + "M", text_color=color.white, text_size=size.small)
    
    // Fila 4 - Sector
    table.cell(t, 0, 4, "Sector", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, sec, text_color=color.yellow, text_size=size.small)

    // Fila 5 - Diagnóstico de Temporalidad
    tf_c = timeframe.isintraday ? color.red : color.green
    tf_t = timeframe.isintraday ? "USAR DIARIO (D)" : "OK (" + timeframe.period + ")"
    table.cell(t, 0, 5, "Gráfico", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, tf_t, text_color=tf_c, text_size=size.small)
