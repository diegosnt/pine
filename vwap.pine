//@version=6
//© Diego Santacruz
indicator(title="VWAP con Bandas Institucionales", shorttitle="VWAP Bands", overlay=true)

// ════════════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓN
// ════════════════════════════════════════════════════════════════════════════════
anchor = input.string("Session", "Anclaje", options=["Session", "Week", "Month", "Year"], group="VWAP")
src = input.source(hlc3, "Fuente", group="VWAP")

mult1 = input.float(1.0, "Banda 1 (SD)", minval=0.5, step=0.5, group="Bandas")
mult2 = input.float(2.0, "Banda 2 (SD)", minval=1.0, step=0.5, group="Bandas")
mult3 = input.float(3.0, "Banda 3 (SD)", minval=1.5, step=0.5, group="Bandas")

show_bands = input.bool(true, "Mostrar Bandas", group="Visualización")

// ════════════════════════════════════════════════════════════════════════════════
// LÓGICA DE CÁLCULO
// ════════════════════════════════════════════════════════════════════════════════

// Detección de reset (Booleanos)
new_day   = timeframe.change("D")
new_week  = timeframe.change("W")
new_month = timeframe.change("M")
new_year  = ta.change(year) != 0

// Cálculo del cambio de período (separado para evitar error CE10156)
bool period_change = switch anchor
    "Session" => new_day
    "Week"    => new_week
    "Month"   => new_month
    "Year"    => new_year
    => new_day

// Reset final (período o primera vela)
anchor_cond = period_change or barstate.isfirst

// Cálculo nativo de VWAP con bandas
[vwap_val, upper1, lower1] = ta.vwap(src, anchor_cond, mult1)
[_, upper2, lower2] = ta.vwap(src, anchor_cond, mult2)
[_, upper3, lower3] = ta.vwap(src, anchor_cond, mult3)

// ════════════════════════════════════════════════════════════════════════════════
// DEBUG Y ALERTAS VISUALES
// ════════════════════════════════════════════════════════════════════════════════

// Si el volumen es 0 o NA, pintamos el fondo de rojo suave para avisar
no_volume = na(volume) or volume <= 0
bgcolor(no_volume ? color.new(color.red, 90) : na, title="Aviso Sin Volumen")

// Cartel de error persistente (borra el anterior antes de crear uno nuevo)
var label lb = na
if barstate.islast and na(vwap_val)
    label.delete(lb)
    lb := label.new(bar_index, high, "⚠️ ERROR: VWAP NA\n¿El activo tiene volumen?", color=color.red, textcolor=color.white, style=label.style_label_down)

// ════════════════════════════════════════════════════════════════════════════════
// PLOTEO
// ════════════════════════════════════════════════════════════════════════════════

vwap_color = src > vwap_val ? color.yellow : color.orange
plot(vwap_val, title="VWAP Central", color=vwap_color, linewidth=2)

// Bandas
p_up1 = plot(show_bands ? upper1 : na, title="Banda Sup 1", color=color.new(color.blue, 60))
p_lo1 = plot(show_bands ? lower1 : na, title="Banda Inf 1", color=color.new(color.blue, 60))
fill(p_up1, p_lo1, color=color.new(color.blue, 95), title="Nube 1")

plot(show_bands ? upper2 : na, title="Banda Sup 2", color=color.red)
plot(show_bands ? lower2 : na, title="Banda Inf 2", color=color.green)

plot(show_bands ? upper3 : na, title="Banda Sup 3", color=color.new(color.red, 10), linewidth=2)
plot(show_bands ? lower3 : na, title="Banda Inf 3", color=color.new(color.green, 10), linewidth=2)

// Alertas
cross_vwap   = ta.cross(src, vwap_val)
cross_band2  = ta.cross(src, upper2) or ta.cross(src, lower2)
cross_band3  = ta.cross(src, upper3) or ta.cross(src, lower3)

alertcondition(cross_vwap,  "Cruce VWAP", "El precio cruzó el VWAP")
alertcondition(cross_band2, "Banda 2 SD", "El precio alcanzó la Banda 2")
alertcondition(cross_band3, "Banda 3 SD", "El precio alcanzó la Banda 3")
