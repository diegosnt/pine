//@version=6
indicator("Operating Margin", shorttitle="OpMargin", overlay=false, precision=2)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
s_in = input.string("Auto", "Sector", options=["Auto", "Tecnologia", "Bancos", "General", "Custom"])
c_l = input.float(5.0, "Min %")
c_h = input.float(15.0, "Max %")
s_tab = input.bool(true, "Mostrar Tabla")

// ─── DATA (CON AUTO-RELLENO DE HUECOS) ────────────────────────────────────────
// Usamos gaps_off para que TradingView mantenga el dato vivo en todo el gráfico
oi_ttm = request.financial(syminfo.tickerid, "OPERATING_INCOME", "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
rv_ttm = request.financial(syminfo.tickerid, "TOTAL_REVENUE",    "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

oi_fy  = request.financial(syminfo.tickerid, "OPERATING_INCOME", "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
rv_fy  = request.financial(syminfo.tickerid, "TOTAL_REVENUE",    "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)

// Consolidamos: TTM es prioridad, FY es el plan B
oi = not na(oi_ttm) ? oi_ttm : oi_fy
rv = not na(rv_ttm) ? rv_ttm : rv_fy

// Cálculo del Margen (%)
mo = (not na(oi) and not na(rv) and rv != 0) ? (oi / rv) * 100 : na

// ─── SECTOR Y RANGOS ──────────────────────────────────────────────────────────
is_tech = syminfo.sector == "Technology Services" or syminfo.sector == "Electronic Technology"
is_bank = syminfo.sector == "Finance" or syminfo.sector == "Energy Minerals" or syminfo.sector == "Utilities"
auto_sec = is_tech ? "Tecnologia" : is_bank ? "Bancos" : "General"
sec = s_in == "Auto" ? auto_sec : s_in

r_l = sec == "Tecnologia" ? 20.0 : sec == "Bancos" ? 15.0 : sec == "Custom" ? c_l : 4.0
r_h = sec == "Tecnologia" ? 40.0 : sec == "Bancos" ? 30.0 : sec == "Custom" ? c_h : 12.0

// ─── VISUALS ──────────────────────────────────────────────────────────────────
c_mo = na(mo) ? color.gray : mo >= r_h ? color.green : mo >= r_l ? color.orange : color.red

// Dibujamos las referencias y el margen
plot(r_l, "Min Ref", color=color.new(color.red, 40), style=plot.style_stepline)
plot(r_h, "Max Ref", color=color.new(color.green, 40), style=plot.style_stepline)
plot(mo,  "Margin %", color=c_mo, linewidth=3, style=plot.style_stepline)

fill(plot(r_l, display=display.none), plot(r_h, display=display.none), color=color.new(color.orange, 92))
hline(0, "Cero", color=color.gray, linestyle=hline.style_dotted)

// ─── TABLA INFORMATIVA (SIN FUNCIONES INTERNAS) ────────────────────────────────
if s_tab and barstate.islast
    var table t = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 75), border_width=1, border_color=color.gray)
    h_bg = color.new(color.teal, 40)
    
    // Fila 0
    table.cell(t, 0, 0, "Margen Op.", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 0, na(mo) ? "N/D" : str.tostring(mo, "#.##") + "%", text_color=c_mo, text_size=size.small)
    
    // Fila 1
    table.cell(t, 0, 1, "Sector", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 1, sec, text_color=color.yellow, text_size=size.small)
    
    // Fila 2
    table.cell(t, 0, 2, "Referencia", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 2, "> " + str.tostring(r_h) + "%", text_color=color.green, text_size=size.small)
    
    // Fila 3
    table.cell(t, 0, 3, "Op. Income", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 3, na(oi) ? "N/D" : str.tostring(oi/1e6, "#") + "M", text_color=color.white, text_size=size.small)
    
    // Fila 4
    table.cell(t, 0, 4, "Total Revenue", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 4, na(rv) ? "N/D" : str.tostring(rv/1e6, "#") + "M", text_color=color.white, text_size=size.small)
    
    // Fila 5 - Alerta de temporalidad
    tf_c = timeframe.isintraday ? color.red : color.green
    tf_t = timeframe.isintraday ? "USAR DIARIO (D)" : "OK (" + timeframe.period + ")"
    table.cell(t, 0, 5, "Gráfico", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(t, 1, 5, tf_t, text_color=tf_c, text_size=size.small)
