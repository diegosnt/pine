//@version=6
//© Diego Santacruz
indicator(title="IndicarPro — Confluencia v7 ULTRA + Premarket + Fundamental", shorttitle="IndicarPro", overlay=true)

// ════════════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓN - CONFLUENCIA
// ════════════════════════════════════════════════════════════════════════════════

// Confluencia mínima requerida
min_confluence = input.int(4, "Confluencia Mínima (de 6)", minval=3, maxval=6, group="Sistema", tooltip="Mínimo 4/6 recomendado para mayor precisión")
min_score = input.int(70, "Score Mínimo (%)", minval=60, maxval=90, group="Sistema", tooltip="Score mínimo para señales fuertes (70% recomendado)")
show_weak_signals = input.bool(false, "Mostrar Señales Débiles", group="Sistema", tooltip="Mostrar señales con confluencia menor a la mínima")

// Filtros de calidad (NUEVOS)
enable_trend_filter = input.bool(true, "Filtro de Tendencia", group="Filtros", tooltip="No comprar en tendencia bajista ni vender en tendencia alcista")
enable_volume_filter = input.bool(true, "Filtro de Volumen", group="Filtros", tooltip="Requerir volumen superior al promedio")
min_bars_between = input.int(5, "Barras Entre Señales", minval=1, maxval=20, group="Filtros", tooltip="Evitar señales muy seguidas")

// Visualización
show_signals = input.bool(true, "Mostrar Señales", group="Visualización")
show_indicators = input.bool(true, "Mostrar Indicadores en Chart", group="Visualización")
show_table = input.bool(true, "Mostrar Tabla de Confluencia", group="Visualización")

// Alertas
enable_alerts = input.bool(true, "Activar Alertas", group="Alertas")

// Parámetros de indicadores
ema_fast = input.int(20, "EMA Rápida", minval=1, group="Parámetros")
ema_slow = input.int(50, "EMA Lenta", minval=1, group="Parámetros")
ema_trend = input.int(200, "EMA Tendencia", minval=1, group="Parámetros")
asl_length = input.int(21, "ASL Length", minval=1, group="Parámetros")
rsi_length = input.int(14, "RSI Length", minval=1, group="Parámetros")
macd_fast = input.int(12, "MACD Fast", minval=1, group="Parámetros")
macd_slow = input.int(26, "MACD Slow", minval=1, group="Parámetros")
macd_signal = input.int(9, "MACD Signal", minval=1, group="Parámetros")

// Colores
color_asl = input.color(#00FF00, "ASL 21", group="Colores")
color_fast = input.color(#2196F3, "EMA Rápida (20)", group="Colores")
color_slow = input.color(#FF9800, "EMA Lenta (50)", group="Colores")
color_trend = input.color(#9C27B0, "EMA Tendencia (200)", group="Colores")

// ════════════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓN - PREMARKET SCANNER
// ════════════════════════════════════════════════════════════════════════════════

// Umbrales
threshold_moderate = input.float(2.0, "Umbral Moderado (%)", minval=0, step=0.5, group="Premarket - Umbrales")
threshold_strong = input.float(5.0, "Umbral Fuerte (%)", minval=0, step=0.5, group="Premarket - Umbrales")
threshold_extreme = input.float(10.0, "Umbral Extremo (%)", minval=0, step=0.5, group="Premarket - Umbrales")

// Scoring
enable_volume_scoring = input.bool(true, "Incluir Volumen en Score", group="Premarket - Scoring")
vol_weight = input.float(30, "Peso del Volumen (%)", minval=0, maxval=50, step=5, group="Premarket - Scoring")

// Visualización
show_pm_table = input.bool(true, "Mostrar Dashboard Premarket", group="Premarket - Visualización")
pm_table_position = input.string("middle_left", "Posición Dashboard PM", options=["top_left", "middle_left", "bottom_left"], group="Premarket - Visualización")
show_gauge = input.bool(true, "Mostrar Medidor de Intensidad", group="Premarket - Visualización")

// ════════════════════════════════════════════════════════════════════════════════
// CONFIGURACIÓN - PANEL FUNDAMENTAL
// ════════════════════════════════════════════════════════════════════════════════

s_in = input.string("Auto", "Sector", options=["Auto", "Tecnologia", "Bancos", "General"], group="Fundamental")
show_panel = input.bool(true, "Mostrar Panel Fundamental", group="Fundamental")

// ════════════════════════════════════════════════════════════════════════════════
// CUSTOM TYPES
// ════════════════════════════════════════════════════════════════════════════════

type IndicatorSignal
    bool bullish
    bool bearish
    float strength
    string status

type ConfluenceResult
    int bullish_count
    int bearish_count
    float bull_score
    float bear_score
    bool strong_buy
    bool strong_sell
    string recommendation

type PremarketScore
    float price_score      // Score de cambio de precio (0-100)
    float volume_score     // Score de volumen (0-100)
    float total_score      // Score total combinado
    string risk_level      // Nivel de riesgo: "NORMAL", "MODERADO", "ALTO", "EXTREMO"
    string opportunity     // Tipo de oportunidad: "COMPRA", "VENTA", "NEUTRO"
    color score_color      // Color según score

type PremarketStats
    float prev_close
    float current_price
    float change_pct
    float volume_current
    float volume_avg
    float volume_ratio
    bool is_premarket
    int bars_to_open      // Barras estimadas hasta apertura

// ════════════════════════════════════════════════════════════════════════════════
// FUNCIONES AUXILIARES - CONFLUENCIA
// ════════════════════════════════════════════════════════════════════════════════

calc_asl(int length) =>
    (ta.ema(close, length-1) + ta.wma(close, length)) / 2

// ════════════════════════════════════════════════════════════════════════════════
// INDICADORES - CONFLUENCIA
// ════════════════════════════════════════════════════════════════════════════════

calc_asl_signal() =>
    asl21 = calc_asl(asl_length)
    crossing_up = ta.crossover(close, asl21)
    crossing_down = ta.crossunder(close, asl21)
    above_asl = close > asl21
    below_asl = close < asl21
    asl_rising = asl21 > asl21[1]
    asl_falling = asl21 < asl21[1]

    strength_bull = 0.0
    strength_bear = 0.0

    if crossing_up and asl_rising
        strength_bull := 1.0
    else if above_asl and asl_rising
        strength_bull := 0.7
    else if above_asl
        strength_bull := 0.4

    if crossing_down and asl_falling
        strength_bear := 1.0
    else if below_asl and asl_falling
        strength_bear := 0.7
    else if below_asl
        strength_bear := 0.4

    status = crossing_up ? "Cruce Alcista" : crossing_down ? "Cruce Bajista" : above_asl and asl_rising ? "Alcista Fuerte" : below_asl and asl_falling ? "Bajista Fuerte" : above_asl ? "Alcista" : below_asl ? "Bajista" : "Neutral"

    [IndicatorSignal.new(strength_bull > 0.5, strength_bear > 0.5, math.max(strength_bull, strength_bear), status), asl21]

calc_ema_signal() =>
    ema20 = ta.ema(close, ema_fast)
    ema50 = ta.ema(close, ema_slow)
    ema200 = ta.ema(close, ema_trend)

    golden_cross = ta.crossover(ema20, ema50)
    death_cross = ta.crossunder(ema20, ema50)
    uptrend = close > ema200
    downtrend = close < ema200
    full_bullish = ema20 > ema50 and ema50 > ema200
    full_bearish = ema20 < ema50 and ema50 < ema200

    strength_bull = 0.0
    strength_bear = 0.0

    if golden_cross and uptrend
        strength_bull := 1.0
    else if ema20 > ema50 and uptrend
        strength_bull := 0.7
    else if uptrend
        strength_bull := 0.3

    if death_cross and downtrend
        strength_bear := 1.0
    else if ema20 < ema50 and downtrend
        strength_bear := 0.7
    else if downtrend
        strength_bear := 0.3

    status = full_bullish ? "Alcista Fuerte" : full_bearish ? "Bajista Fuerte" : uptrend ? "Alcista" : downtrend ? "Bajista" : "Neutral"

    [IndicatorSignal.new(strength_bull > 0.5, strength_bear > 0.5, math.max(strength_bull, strength_bear), status), ema20, ema50, ema200]

calc_macd_signal() =>
    [macd_line, signal_line, hist] = ta.macd(close, macd_fast, macd_slow, macd_signal)

    bullish_cross = ta.crossover(macd_line, signal_line)
    bearish_cross = ta.crossunder(macd_line, signal_line)
    above_zero = macd_line > 0
    below_zero = macd_line < 0
    hist_growing = hist > hist[1]
    hist_falling = hist < hist[1]

    strength_bull = 0.0
    strength_bear = 0.0

    if bullish_cross and above_zero
        strength_bull := 1.0
    else if bullish_cross
        strength_bull := 0.7
    else if macd_line > signal_line and hist_growing
        strength_bull := 0.5
    else if macd_line > signal_line
        strength_bull := 0.3

    if bearish_cross and below_zero
        strength_bear := 1.0
    else if bearish_cross
        strength_bear := 0.7
    else if macd_line < signal_line and hist_falling
        strength_bear := 0.5
    else if macd_line < signal_line
        strength_bear := 0.3

    status = bullish_cross ? "Cruce Alcista" : bearish_cross ? "Cruce Bajista" : macd_line > signal_line and above_zero ? "Alcista Fuerte" : macd_line < signal_line and below_zero ? "Bajista Fuerte" : macd_line > signal_line ? "Alcista" : macd_line < signal_line ? "Bajista" : "Neutral"

    IndicatorSignal.new(strength_bull > 0.5, strength_bear > 0.5, math.max(strength_bull, strength_bear), status)

calc_rsi_signal() =>
    rsi = ta.rsi(close, rsi_length)

    oversold = rsi < 30
    overbought = rsi > 70
    neutral_low = rsi >= 30 and rsi < 50
    neutral_high = rsi >= 50 and rsi <= 70
    crossing_up_30 = ta.crossover(rsi, 30)
    crossing_down_70 = ta.crossunder(rsi, 70)
    crossing_up_50 = ta.crossover(rsi, 50)
    crossing_down_50 = ta.crossunder(rsi, 50)

    strength_bull = 0.0
    strength_bear = 0.0

    if crossing_up_30
        strength_bull := 1.0
    else if crossing_up_50
        strength_bull := 0.8
    else if neutral_high
        strength_bull := 0.5
    else if oversold
        strength_bull := 0.7

    if crossing_down_70
        strength_bear := 1.0
    else if crossing_down_50
        strength_bear := 0.8
    else if neutral_low
        strength_bear := 0.5
    else if overbought
        strength_bear := 0.7

    status = oversold ? "Sobreventa" : overbought ? "Sobrecompra" : crossing_up_30 ? "Salida Sobreventa" : crossing_down_70 ? "Salida Sobrecompra" : neutral_high ? "Alcista" : neutral_low ? "Bajista" : "Neutral"

    IndicatorSignal.new(strength_bull > 0.5, strength_bear > 0.5, math.max(strength_bull, strength_bear), status)

calc_volume_signal() =>
    vol_ma = ta.sma(volume, 20)
    high_volume = volume > vol_ma * 1.5
    price_up = close > close[1]
    price_down = close < close[1]
    body_size = math.abs(close - open)
    avg_body = ta.sma(body_size, 14)
    strong_candle = body_size > avg_body * 1.5

    strength_bull = 0.0
    strength_bear = 0.0

    if high_volume and price_up and strong_candle
        strength_bull := 1.0
    else if high_volume and price_up
        strength_bull := 0.7
    else if price_up
        strength_bull := 0.3

    if high_volume and price_down and strong_candle
        strength_bear := 1.0
    else if high_volume and price_down
        strength_bear := 0.7
    else if price_down
        strength_bear := 0.3

    status = high_volume and price_up ? "Compra Fuerte" : high_volume and price_down ? "Venta Fuerte" : price_up ? "Compra Normal" : price_down ? "Venta Normal" : "Neutral"

    [IndicatorSignal.new(strength_bull > 0.5, strength_bear > 0.5, math.max(strength_bull, strength_bear), status), volume, vol_ma]

calc_momentum_signal() =>
    roc = ta.roc(close, 10)
    roc_ma = ta.sma(roc, 10)
    positive_momentum = roc > 0
    negative_momentum = roc < 0
    accelerating = roc > roc_ma
    decelerating = roc < roc_ma

    strength_bull = 0.0
    strength_bear = 0.0

    if positive_momentum and accelerating and roc > 2
        strength_bull := 1.0
    else if positive_momentum and accelerating
        strength_bull := 0.7
    else if positive_momentum
        strength_bull := 0.4

    if negative_momentum and decelerating and roc < -2
        strength_bear := 1.0
    else if negative_momentum and decelerating
        strength_bear := 0.7
    else if negative_momentum
        strength_bear := 0.4

    status = positive_momentum and accelerating ? "Acelerando ↑" : negative_momentum and decelerating ? "Acelerando ↓" : positive_momentum ? "Positivo" : negative_momentum ? "Negativo" : "Neutral"

    IndicatorSignal.new(strength_bull > 0.5, strength_bear > 0.5, math.max(strength_bull, strength_bear), status)

// ════════════════════════════════════════════════════════════════════════════════
// FILTROS DE CALIDAD - CONFLUENCIA
// ════════════════════════════════════════════════════════════════════════════════

apply_quality_filters(is_buy, ema20, ema50, ema200, vol, vol_ma, last_signal_bar) =>
    filter_pass = true

    // Filtro de tendencia
    if enable_trend_filter
        if is_buy
            strong_downtrend = close < ema200 and ema20 < ema50 and ema50 < ema200
            filter_pass := filter_pass and not strong_downtrend
        else
            strong_uptrend = close > ema200 and ema20 > ema50 and ema50 > ema200
            filter_pass := filter_pass and not strong_uptrend

    // Filtro de volumen
    if enable_volume_filter
        filter_pass := filter_pass and vol >= vol_ma * 0.8

    // Filtro de cooldown
    bars_since = bar_index - last_signal_bar
    cooldown_ok = bars_since >= min_bars_between
    filter_pass := filter_pass and cooldown_ok

    filter_pass

// ════════════════════════════════════════════════════════════════════════════════
// CÁLCULO DE CONFLUENCIA
// ════════════════════════════════════════════════════════════════════════════════

calc_confluence(last_buy_bar, last_sell_bar) =>
    [asl_sig, asl21] = calc_asl_signal()
    [ema_sig, ema20, ema50, ema200] = calc_ema_signal()
    macd_sig = calc_macd_signal()
    rsi_sig = calc_rsi_signal()
    [vol_sig, vol, vol_ma] = calc_volume_signal()
    mom_sig = calc_momentum_signal()

    // Contar votos
    bull_count = 0
    bear_count = 0

    if asl_sig.bullish
        bull_count += 1
    if asl_sig.bearish
        bear_count += 1
    if ema_sig.bullish
        bull_count += 1
    if ema_sig.bearish
        bear_count += 1
    if macd_sig.bullish
        bull_count += 1
    if macd_sig.bearish
        bear_count += 1
    if rsi_sig.bullish
        bull_count += 1
    if rsi_sig.bearish
        bear_count += 1
    if vol_sig.bullish
        bull_count += 1
    if vol_sig.bearish
        bear_count += 1
    if mom_sig.bullish
        bull_count += 1
    if mom_sig.bearish
        bear_count += 1

    // Score ponderado (EMAs y MACD más peso)
    bull_score = asl_sig.strength * 15 + ema_sig.strength * 25 + macd_sig.strength * 25 + rsi_sig.strength * 15 + vol_sig.strength * 10 + mom_sig.strength * 10
    bear_score = asl_sig.strength * 15 + ema_sig.strength * 25 + macd_sig.strength * 25 + rsi_sig.strength * 15 + vol_sig.strength * 10 + mom_sig.strength * 10

    final_bull_score = asl_sig.bullish or ema_sig.bullish or macd_sig.bullish or rsi_sig.bullish or vol_sig.bullish or mom_sig.bullish ? bull_score : 0
    final_bear_score = asl_sig.bearish or ema_sig.bearish or macd_sig.bearish or rsi_sig.bearish or vol_sig.bearish or mom_sig.bearish ? bear_score : 0

    // Señales base
    strong_buy_base = bull_count >= min_confluence and final_bull_score >= min_score
    strong_sell_base = bear_count >= min_confluence and final_bear_score >= min_score

    // Aplicar filtros
    buy_pass = apply_quality_filters(true, ema20, ema50, ema200, vol, vol_ma, last_buy_bar)
    sell_pass = apply_quality_filters(false, ema20, ema50, ema200, vol, vol_ma, last_sell_bar)

    strong_buy = strong_buy_base and buy_pass
    strong_sell = strong_sell_base and sell_pass

    recommendation = strong_buy ? "COMPRAR 🚀" : strong_sell ? "VENDER ⚠️" : bull_count >= 3 ? "Compra (débil)" : bear_count >= 3 ? "Venta (débil)" : bull_count > bear_count ? "Sesgo Alcista" : bear_count > bull_count ? "Sesgo Bajista" : "ESPERAR ⏸"

    [ConfluenceResult.new(bull_count, bear_count, final_bull_score, final_bear_score, strong_buy, strong_sell, recommendation), asl_sig, ema_sig, macd_sig, rsi_sig, vol_sig, mom_sig, asl21, ema20, ema50, ema200]

// ════════════════════════════════════════════════════════════════════════════════
// FUNCIONES CORE - PREMARKET SCANNER
// ════════════════════════════════════════════════════════════════════════════════

// Obtener color según score
get_score_color(score, is_positive) =>
    base_color = switch
        score >= 85 => is_positive ? #00FF00 : #FF0000  // Muy alto
        score >= 65 => is_positive ? #88FF00 : #FF6600  // Alto
        score >= 40 => is_positive ? #FFFF00 : #FFA500  // Moderado
        => color.gray  // Bajo

    base_color

// Calcular estadísticas de premarket
calc_premarket_stats() =>
    // Precio de cierre anterior
    prev_close = request.security(syminfo.tickerid, "D", close[1], barmerge.gaps_off, barmerge.lookahead_on)

    // Precio actual
    current = close

    // Cambio porcentual
    change_pct = prev_close != 0 ? ((current - prev_close) / prev_close) * 100 : 0

    // Volumen
    vol_current = volume
    vol_avg = ta.sma(volume, 20)
    vol_ratio = vol_avg != 0 ? vol_current / vol_avg : 1

    // Sesión
    is_pm = session.ispremarket

    // Estimación de barras hasta apertura (aproximado para 5min chart)
    bars_to_open = is_pm ? na : na

    PremarketStats.new(prev_close, current, change_pct, vol_current, vol_avg, vol_ratio, is_pm, bars_to_open)

// Calcular score de premarket
calc_premarket_score(stats) =>
    // Score de precio (0-100)
    abs_change = math.abs(stats.change_pct)

    price_score = switch
        abs_change >= threshold_extreme => 100.0
        abs_change >= threshold_strong => 70.0 + (abs_change - threshold_strong) / (threshold_extreme - threshold_strong) * 30
        abs_change >= threshold_moderate => 40.0 + (abs_change - threshold_moderate) / (threshold_strong - threshold_moderate) * 30
        => (abs_change / threshold_moderate) * 40

    // Score de volumen (0-100)
    vol_score = switch
        stats.volume_ratio >= 3.0 => 100.0
        stats.volume_ratio >= 2.0 => 70.0 + (stats.volume_ratio - 2.0) * 30
        stats.volume_ratio >= 1.0 => 40.0 + (stats.volume_ratio - 1.0) * 30
        => stats.volume_ratio * 40

    // Score total (combinado)
    price_weight = 100 - vol_weight
    total_score = enable_volume_scoring ? (price_score * price_weight / 100 + vol_score * vol_weight / 100) : price_score

    // Nivel de riesgo/oportunidad
    risk_level = switch
        total_score >= 85 => "🔥 EXTREMO"
        total_score >= 65 => "⚠️ ALTO"
        total_score >= 40 => "⚡ MODERADO"
        => "• NORMAL"

    // Tipo de oportunidad
    opportunity = switch
        stats.change_pct > threshold_strong => "🚀 COMPRA FUERTE"
        stats.change_pct > threshold_moderate => "📈 COMPRA"
        stats.change_pct < -threshold_strong => "🔻 VENTA FUERTE"
        stats.change_pct < -threshold_moderate => "📉 VENTA"
        => "➡️ NEUTRO"

    // Color según score
    score_color = get_score_color(total_score, stats.change_pct > 0)

    PremarketScore.new(price_score, vol_score, total_score, risk_level, opportunity, score_color)

// ════════════════════════════════════════════════════════════════════════════════
// CUSTOM METHODS - PREMARKET SCANNER
// ════════════════════════════════════════════════════════════════════════════════

// Obtener barra de progreso visual (gauge)
method get_gauge_bar(PremarketScore this, width) =>
    filled_bars = math.floor(this.total_score / 100 * width)
    gauge = ""
    for i = 0 to width - 1
        gauge := gauge + (i < filled_bars ? "█" : "░")
    gauge

// Obtener calificación con letra
method get_grade(PremarketScore this) =>
    switch
        this.total_score >= 90 => "A+"
        this.total_score >= 80 => "A"
        this.total_score >= 70 => "B+"
        this.total_score >= 60 => "B"
        this.total_score >= 50 => "C"
        this.total_score >= 40 => "D"
        => "F"

// ════════════════════════════════════════════════════════════════════════════════
// DATOS FUNDAMENTALES (GLOBAL SCOPE)
// ════════════════════════════════════════════════════════════════════════════════

// P/E
eps_ttm = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE", "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
eps_fy  = request.financial(syminfo.tickerid, "EARNINGS_PER_SHARE", "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
f_eps = not na(eps_ttm) ? eps_ttm : eps_fy
f_pe = f_eps > 0 ? close / f_eps : na

// EV / EBITDA
ev_ttm = request.financial(syminfo.tickerid, "ENTERPRISE_VALUE", "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
ev_fy  = request.financial(syminfo.tickerid, "ENTERPRISE_VALUE", "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
f_ev = not na(ev_ttm) ? ev_ttm : ev_fy

eb_ttm = request.financial(syminfo.tickerid, "EBITDA", "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
eb_fy  = request.financial(syminfo.tickerid, "EBITDA", "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
f_eb = not na(eb_ttm) ? eb_ttm : eb_fy
f_ev_eb = f_eb > 0 ? f_ev / f_eb : na

// Margen Operativo
oi_ttm = request.financial(syminfo.tickerid, "OPERATING_INCOME", "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
oi_fy  = request.financial(syminfo.tickerid, "OPERATING_INCOME", "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
f_oi = not na(oi_ttm) ? oi_ttm : oi_fy

rv_ttm = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
rv_fy  = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
f_rv = not na(rv_ttm) ? rv_ttm : rv_fy
f_mo = (f_rv != 0 and not na(f_oi) and not na(f_rv)) ? (f_oi / f_rv) * 100 : na

// Deuda / EBITDA
nd_ttm = request.financial(syminfo.tickerid, "NET_DEBT", "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
nd_fy  = request.financial(syminfo.tickerid, "NET_DEBT", "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
f_nd = not na(nd_ttm) ? nd_ttm : nd_fy
f_de_eb = (f_eb > 0 and not na(f_nd)) ? f_nd / f_eb : na

// ROIC
ro_ttm = request.financial(syminfo.tickerid, "RETURN_ON_INVESTED_CAPITAL", "TTM", gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
ro_fy  = request.financial(syminfo.tickerid, "RETURN_ON_INVESTED_CAPITAL", "FY",  gaps=barmerge.gaps_off, ignore_invalid_symbol=true)
f_roic = not na(ro_ttm) ? ro_ttm : ro_fy

// ════════════════════════════════════════════════════════════════════════════════
// LÓGICA DE COLORES - FUNDAMENTAL
// ════════════════════════════════════════════════════════════════════════════════

is_t = syminfo.sector == "Technology Services" or syminfo.sector == "Electronic Technology"
is_b = syminfo.sector == "Finance" or syminfo.sector == "Energy Minerals" or syminfo.sector == "Utilities"
auto_s = is_t ? "Tecnologia" : is_b ? "Bancos" : "General"
sec = s_in == "Auto" ? auto_s : s_in

pe_c  = na(f_pe)    ? color.gray : f_pe    < (sec == "Tecnologia" ? 25 : sec == "Bancos" ? 8  : 15) ? color.green : f_pe    <= (sec == "Tecnologia" ? 35 : sec == "Bancos" ? 12 : 25) ? color.orange : color.red
ee_c  = na(f_ev_eb) ? color.gray : f_ev_eb < (sec == "Tecnologia" ? 12 : sec == "Bancos" ? 6  : 10) ? color.green : f_ev_eb <= (sec == "Tecnologia" ? 22 : sec == "Bancos" ? 10 : 15) ? color.orange : color.red
mo_c  = na(f_mo)    ? color.gray : f_mo   >= (sec == "Tecnologia" ? 40 : sec == "Bancos" ? 30 : 12) ? color.green : f_mo   >= (sec == "Tecnologia" ? 20 : sec == "Bancos" ? 15 :  4) ? color.orange : color.red
de_c  = na(f_de_eb) ? color.gray : f_de_eb < 2.0 ? color.green : f_de_eb <= 4.0 ? color.orange : color.red
ro_c  = na(f_roic)  ? color.gray : f_roic >= 25.0 ? color.green : f_roic >= 10.0 ? color.orange : color.red

// ════════════════════════════════════════════════════════════════════════════════
// CÁLCULOS PRINCIPALES
// ════════════════════════════════════════════════════════════════════════════════

// Cálculos de Confluencia
var int last_buy_bar = -999
var int last_sell_bar = -999

[confluence, asl_sig, ema_sig, macd_sig, rsi_sig, vol_sig, mom_sig, asl21, ema20, ema50, ema200] = calc_confluence(last_buy_bar, last_sell_bar)

var bool prev_strong_buy = false
var bool prev_strong_sell = false

new_buy_signal = confluence.strong_buy and not prev_strong_buy
new_sell_signal = confluence.strong_sell and not prev_strong_sell

// Actualizar cooldown si hay señal
if new_buy_signal
    last_buy_bar := bar_index
if new_sell_signal
    last_sell_bar := bar_index

prev_strong_buy := confluence.strong_buy
prev_strong_sell := confluence.strong_sell

// Cálculos de Premarket Scanner
pm_stats = calc_premarket_stats()
pm_score = calc_premarket_score(pm_stats)

// ════════════════════════════════════════════════════════════════════════════════
// PLOTEO - CONFLUENCIA
// ════════════════════════════════════════════════════════════════════════════════

plot(show_indicators ? asl21 : na, "ASL 21", color=color.new(color_asl, 0), linewidth=2)
plot(show_indicators ? ema20 : na, "EMA 20", color=color.new(color_fast, 0), linewidth=2)
plot(show_indicators ? ema50 : na, "EMA 50", color=color.new(color_slow, 0), linewidth=2)
plot(show_indicators ? ema200 : na, "EMA 200", color=color.new(color_trend, 0), linewidth=3)

if barstate.islast and show_indicators
    label.new(x=time, y=asl21, text="ASL21", xloc=xloc.bar_time, yloc=yloc.price, color=color.rgb(0, 0, 0, 100), style=label.style_label_left, textcolor=color_asl, size=size.small)
    label.new(x=time, y=ema20, text="EMA20", xloc=xloc.bar_time, yloc=yloc.price, color=color.rgb(0, 0, 0, 100), style=label.style_label_left, textcolor=color_fast, size=size.small)
    label.new(x=time, y=ema50, text="EMA50", xloc=xloc.bar_time, yloc=yloc.price, color=color.rgb(0, 0, 0, 100), style=label.style_label_left, textcolor=color_slow, size=size.small)
    label.new(x=time, y=ema200, text="EMA200", xloc=xloc.bar_time, yloc=yloc.price, color=color.rgb(0, 0, 0, 100), style=label.style_label_left, textcolor=color_trend, size=size.small)

// ════════════════════════════════════════════════════════════════════════════════
// SEÑALES - CONFLUENCIA
// ════════════════════════════════════════════════════════════════════════════════

if show_signals and new_buy_signal
    label.new(bar_index, low, text="✓ COMPRA\n" + str.tostring(confluence.bullish_count) + "/6 • " + str.tostring(confluence.bull_score, "#") + "%\n$" + str.tostring(close, "#.##"), color=color.new(#044A04, 0), textcolor=color.white, style=label.style_label_up, size=size.small)

if show_signals and new_sell_signal
    label.new(bar_index, high, text="✓ VENTA\n" + str.tostring(confluence.bearish_count) + "/6 • " + str.tostring(confluence.bear_score, "#") + "%\n$" + str.tostring(close, "#.##"), color=color.new(#7A1C1C, 0), textcolor=color.white, style=label.style_label_down, size=size.small)

weak_buy = confluence.bullish_count >= 2 and confluence.bullish_count < min_confluence and confluence.bullish_count > confluence.bearish_count
weak_sell = confluence.bearish_count >= 2 and confluence.bearish_count < min_confluence and confluence.bearish_count > confluence.bullish_count

if show_signals and show_weak_signals and weak_buy and not confluence.strong_buy
    label.new(bar_index, low, text=str.tostring(confluence.bullish_count) + "/6", color=color.new(color.green, 50), textcolor=color.white, style=label.style_label_up, size=size.tiny)

if show_signals and show_weak_signals and weak_sell and not confluence.strong_sell
    label.new(bar_index, high, text=str.tostring(confluence.bearish_count) + "/6", color=color.new(color.red, 50), textcolor=color.white, style=label.style_label_down, size=size.tiny)

plotshape(show_signals and new_buy_signal, "Compra Fuerte", shape.triangleup, location.belowbar, color.new(#044A04, 0), size=size.small)
plotshape(show_signals and new_sell_signal, "Venta Fuerte", shape.triangledown, location.abovebar, color.new(#7A1C1C, 0), size=size.small)

// ════════════════════════════════════════════════════════════════════════════════
// TABLA - CONFLUENCIA (top_right)
// ════════════════════════════════════════════════════════════════════════════════

if show_table and barstate.islast
    var table conf_table = table.new(position.top_right, 3, 10, border_width=1, border_color=color.gray, frame_width=1, frame_color=color.gray)

    table.cell(conf_table, 0, 0, "Sistema Confluencia v7 ULTRA", text_color=color.white, bgcolor=color.new(color.purple, 20), text_size=size.normal)
    table.merge_cells(conf_table, 0, 0, 2, 0)

    table.cell(conf_table, 0, 1, "Precio", text_color=color.white, bgcolor=color.new(color.gray, 50))
    table.cell(conf_table, 1, 1, "$" + str.tostring(close, "#.##"), text_color=color.white, bgcolor=color.new(color.blue, 70))
    table.merge_cells(conf_table, 1, 1, 2, 1)

    conf_text = str.tostring(confluence.bullish_count) + "/6 🟢  " + str.tostring(confluence.bearish_count) + "/6 🔴"
    table.cell(conf_table, 0, 2, "Confluencia", text_color=color.white, bgcolor=color.new(color.gray, 50))
    table.cell(conf_table, 1, 2, conf_text, text_color=color.white, bgcolor=color.new(color.gray, 80))
    table.merge_cells(conf_table, 1, 2, 2, 2)

    table.cell(conf_table, 0, 3, "Score", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(conf_table, 1, 3, "🟢 " + str.tostring(confluence.bull_score, "#") + "%", text_color=color.white, bgcolor=color.new(color.green, 70), text_size=size.small)
    table.cell(conf_table, 2, 3, "🔴 " + str.tostring(confluence.bear_score, "#") + "%", text_color=color.white, bgcolor=color.new(color.red, 70), text_size=size.small)

    table.cell(conf_table, 0, 4, "📊 Indicador", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(conf_table, 1, 4, "Señal", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(conf_table, 2, 4, "Estado", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)

    asl_vote = asl_sig.bullish ? "🟢" : asl_sig.bearish ? "🔴" : "⚪"
    table.cell(conf_table, 0, 5, "ASL21", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)
    table.cell(conf_table, 1, 5, asl_vote, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(conf_table, 2, 5, asl_sig.status, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)

    ema_vote = ema_sig.bullish ? "🟢" : ema_sig.bearish ? "🔴" : "⚪"
    table.cell(conf_table, 0, 6, "EMAs", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)
    table.cell(conf_table, 1, 6, ema_vote, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(conf_table, 2, 6, ema_sig.status, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)

    macd_vote = macd_sig.bullish ? "🟢" : macd_sig.bearish ? "🔴" : "⚪"
    table.cell(conf_table, 0, 7, "MACD", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)
    table.cell(conf_table, 1, 7, macd_vote, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(conf_table, 2, 7, macd_sig.status, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)

    rsi_vote = rsi_sig.bullish ? "🟢" : rsi_sig.bearish ? "🔴" : "⚪"
    table.cell(conf_table, 0, 8, "RSI", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)
    table.cell(conf_table, 1, 8, rsi_vote, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(conf_table, 2, 8, rsi_sig.status, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)

    vol_mom_bull = vol_sig.bullish or mom_sig.bullish
    vol_mom_bear = vol_sig.bearish or mom_sig.bearish
    vol_mom_vote = vol_mom_bull ? "🟢" : vol_mom_bear ? "🔴" : "⚪"
    vol_mom_status = vol_sig.status + " / " + mom_sig.status
    table.cell(conf_table, 0, 9, "Vol/Mom", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)
    table.cell(conf_table, 1, 9, vol_mom_vote, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)
    table.cell(conf_table, 2, 9, vol_mom_status, text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.tiny)

// ════════════════════════════════════════════════════════════════════════════════
// TABLA - RECOMENDACIÓN (bottom_right)
// ════════════════════════════════════════════════════════════════════════════════

if show_table and barstate.islast
    var table rec_table = table.new(position.bottom_right, 2, 2, border_width=2, border_color=color.gray, frame_width=2, frame_color=color.gray)

    table.cell(rec_table, 0, 0, "RECOMENDACIÓN", text_color=color.white, bgcolor=color.new(color.blue, 20), text_size=size.small)
    table.merge_cells(rec_table, 0, 0, 1, 0)

    rec_color = confluence.strong_buy ? color.new(color.lime, 30) : confluence.strong_sell ? color.new(color.maroon, 30) : color.new(color.gray, 60)
    rec_text = confluence.recommendation
    if confluence.strong_buy or confluence.strong_sell
        rec_text := rec_text + "\n$" + str.tostring(close, "#.##")

    table.cell(rec_table, 0, 1, rec_text, text_color=color.white, bgcolor=rec_color, text_size=size.normal)
    table.merge_cells(rec_table, 0, 1, 1, 1)

// ════════════════════════════════════════════════════════════════════════════════
// DASHBOARD - PREMARKET SCANNER (middle_left)
// ════════════════════════════════════════════════════════════════════════════════

if show_pm_table and barstate.islast
    // Posición de tabla
    pos = switch pm_table_position
        "top_left" => position.top_left
        "middle_left" => position.middle_left
        "bottom_left" => position.bottom_left
        => position.middle_left

    var table pm_dashboard = table.new(pos, 2, 13, border_width=2, border_color=color.gray)

    // === HEADER ===
    table.cell(pm_dashboard, 0, 0, "📊 PREMARKET SCANNER", text_color=color.white, bgcolor=color.new(color.blue, 20), text_size=size.normal)
    table.merge_cells(pm_dashboard, 0, 0, 1, 0)

    // === ESTADO ===
    session_text = pm_stats.is_premarket ? "🟢 PREMARKET" : "⚪ REGULAR"
    session_bg = pm_stats.is_premarket ? color.new(color.green, 50) : color.new(color.gray, 70)
    table.cell(pm_dashboard, 0, 1, "Estado", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(pm_dashboard, 1, 1, session_text, text_color=color.white, bgcolor=session_bg, text_size=size.small)

    // === PRECIO ===
    table.cell(pm_dashboard, 0, 2, "Cierre Prev", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(pm_dashboard, 1, 2, "$" + str.tostring(pm_stats.prev_close, "#.##"), text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)

    table.cell(pm_dashboard, 0, 3, "Precio Actual", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(pm_dashboard, 1, 3, "$" + str.tostring(pm_stats.current_price, "#.##"), text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)

    table.cell(pm_dashboard, 0, 4, "Cambio %", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    change_text = (pm_stats.change_pct > 0 ? "+" : "") + str.tostring(pm_stats.change_pct, "#.##") + "%"
    table.cell(pm_dashboard, 1, 4, change_text, text_color=color.white, bgcolor=color.new(pm_score.score_color, 40), text_size=size.normal)

    // === VOLUMEN ===
    table.cell(pm_dashboard, 0, 5, "Vol Ratio", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    vol_text = str.tostring(pm_stats.volume_ratio, "#.##") + "x"
    vol_color = pm_stats.volume_ratio >= 2 ? color.new(color.lime, 50) : pm_stats.volume_ratio >= 1 ? color.new(color.yellow, 50) : color.new(color.gray, 70)
    table.cell(pm_dashboard, 1, 5, vol_text, text_color=color.white, bgcolor=vol_color, text_size=size.small)

    // === SCORES ===
    table.cell(pm_dashboard, 0, 6, "Score Precio", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(pm_dashboard, 1, 6, str.tostring(pm_score.price_score, "#") + "/100", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)

    if enable_volume_scoring
        table.cell(pm_dashboard, 0, 7, "Score Vol", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
        table.cell(pm_dashboard, 1, 7, str.tostring(pm_score.volume_score, "#") + "/100", text_color=color.white, bgcolor=color.new(color.gray, 80), text_size=size.small)

    // === SCORE TOTAL ===
    row = enable_volume_scoring ? 8 : 7
    table.cell(pm_dashboard, 0, row, "🎯 SCORE TOTAL", text_color=color.white, bgcolor=color.new(color.purple, 30), text_size=size.small)
    table.cell(pm_dashboard, 1, row, str.tostring(pm_score.total_score, "#") + "/100", text_color=color.white, bgcolor=color.new(pm_score.score_color, 30), text_size=size.normal)

    // === GAUGE ===
    if show_gauge
        row += 1
        table.cell(pm_dashboard, 0, row, "Intensidad", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.tiny)
        gauge_bar = pm_score.get_gauge_bar(10)
        table.cell(pm_dashboard, 1, row, gauge_bar, text_color=pm_score.score_color, bgcolor=color.new(color.black, 20), text_size=size.small)

    // === CALIFICACIÓN ===
    row += 1
    table.cell(pm_dashboard, 0, row, "Calificación", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(pm_dashboard, 1, row, pm_score.get_grade(), text_color=color.white, bgcolor=color.new(pm_score.score_color, 40), text_size=size.large)

    // === NIVEL DE RIESGO ===
    row += 1
    table.cell(pm_dashboard, 0, row, "Nivel", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(pm_dashboard, 1, row, pm_score.risk_level, text_color=color.white, bgcolor=color.new(pm_score.score_color, 30), text_size=size.small)

    // === OPORTUNIDAD ===
    row += 1
    table.cell(pm_dashboard, 0, row, "Señal", text_color=color.white, bgcolor=color.new(color.gray, 50), text_size=size.small)
    table.cell(pm_dashboard, 1, row, pm_score.opportunity, text_color=color.white, bgcolor=color.new(pm_score.score_color, 30), text_size=size.small)

// ════════════════════════════════════════════════════════════════════════════════
// PANEL - FUNDAMENTAL (middle_right)
// ════════════════════════════════════════════════════════════════════════════════

if show_panel and barstate.islast
    var table fund_table = table.new(position.middle_right, 3, 8, bgcolor=color.new(color.black, 70), border_width=1, border_color=color.gray)
    h_bg = color.new(color.blue, 40)

    // Encabezado
    table.cell(fund_table, 0, 0, "Métrica Fundamental", bgcolor=color.new(color.gray, 20), text_color=color.white, text_size=size.small)
    table.cell(fund_table, 1, 0, "Valor", bgcolor=color.new(color.gray, 20), text_color=color.white, text_size=size.small)
    table.cell(fund_table, 2, 0, "Semáf.", bgcolor=color.new(color.gray, 20), text_color=color.white, text_size=size.small)

    // Price-to-Earnings
    table.cell(fund_table, 0, 1, "P/E Ratio", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(fund_table, 1, 1, na(f_pe) ? "N/D" : str.tostring(f_pe, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(fund_table, 2, 1, " ● ", text_color=pe_c, text_size=size.large)

    // EV/EBITDA
    table.cell(fund_table, 0, 2, "EV / EBITDA", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(fund_table, 1, 2, na(f_ev_eb) ? "N/D" : str.tostring(f_ev_eb, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(fund_table, 2, 2, " ● ", text_color=ee_c, text_size=size.large)

    // Margen Operativo
    table.cell(fund_table, 0, 3, "Margen Op.", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(fund_table, 1, 3, na(f_mo) ? "N/D" : str.tostring(f_mo, "#.##") + "%", text_color=color.white, text_size=size.small)
    table.cell(fund_table, 2, 3, " ● ", text_color=mo_c, text_size=size.large)

    // Deuda / EBITDA
    table.cell(fund_table, 0, 4, "Deuda / EBITDA", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(fund_table, 1, 4, na(f_de_eb) ? "N/D" : str.tostring(f_de_eb, "#.##"), text_color=color.white, text_size=size.small)
    table.cell(fund_table, 2, 4, " ● ", text_color=de_c, text_size=size.large)

    // ROIC
    table.cell(fund_table, 0, 5, "ROIC", bgcolor=h_bg, text_color=color.white, text_size=size.small)
    table.cell(fund_table, 1, 5, na(f_roic) ? "N/D" : str.tostring(f_roic, "#.##") + "%", text_color=color.white, text_size=size.small)
    table.cell(fund_table, 2, 5, " ● ", text_color=ro_c, text_size=size.large)

    // Footer
    table.cell(fund_table, 0, 6, "Sector: " + sec, bgcolor=color.new(color.teal, 50), text_color=color.white, text_size=size.tiny)
    table.merge_cells(fund_table, 0, 6, 2, 6)

    if timeframe.isintraday
        table.cell(fund_table, 0, 7, "USAR EN DIARIO (D)", bgcolor=color.new(color.red, 40), text_color=color.white, text_size=size.tiny)
        table.merge_cells(fund_table, 0, 7, 2, 7)

// ════════════════════════════════════════════════════════════════════════════════
// ALERTAS
// ════════════════════════════════════════════════════════════════════════════════

alertcondition(enable_alerts and new_buy_signal, "CONFLUENCIA v7: COMPRA", "🚀 COMPRAR ${{close}} - {{plot_0}}/6 - {{plot_1}}%")
alertcondition(enable_alerts and new_sell_signal, "CONFLUENCIA v7: VENTA", "⚠️ VENDER ${{close}} - {{plot_0}}/6 - {{plot_1}}%")

plot(confluence.bullish_count, "Bull Count", display=display.none)
plot(confluence.bull_score, "Bull Score", display=display.none)
