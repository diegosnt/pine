//@version=6
indicator("Enterprise Value to EBITDA (EV/EBITDA)", shorttitle="EV/EBITDA", overlay=false)

// ─── INPUTS ───────────────────────────────────────────────────────────────────
sector_input = input.string("Auto", "Sector de referencia",
                 options=["Auto", "Tecnologia", "Bancos / Energia", "General", "Personalizado"])
custom_low   = input.float(10, "EV/EBITDA mínimo (personalizado)", minval=1)
custom_high  = input.float(20, "EV/EBITDA máximo (personalizado)", minval=1)
show_table   = input.bool(true, "Mostrar tabla")

// ─── DETECCIÓN AUTOMÁTICA DE SECTOR ───────────────────────────────────────────
// Los rangos de EV/EBITDA también varían por sector, similar al P/E
auto_sector = switch
    syminfo.sector == "Technology Services" or syminfo.sector == "Electronic Technology" => "Tecnologia"
    syminfo.sector == "Finance" or syminfo.sector == "Energy Minerals" or syminfo.sector == "Utilities" => "Bancos / Energia"
    => "General"

sector = sector_input == "Auto" ? auto_sector : sector_input

// ─── DATOS FINANCIEROS ────────────────────────────────────────────────────────
// Pedimos el Enterprise Value y el EBITDA (TTM)
ev     = request.financial(syminfo.tickerid, "ENTERPRISE_VALUE", "FQ", ignore_invalid_symbol=true)
ebitda = request.financial(syminfo.tickerid, "EBITDA", "TTM", ignore_invalid_symbol=true)

// Cálculo del ratio
ev_ebitda = ebitda > 0 ? ev / ebitda : na

// ─── RANGOS DE REFERENCIA (Basados en tu pedido) ─────────────────────────────
// Ref: < 10 barato, 10-15 razonable, > 20 precaución
ref_low  = sector == "Tecnologia"       ? 12.0 :
           sector == "Bancos / Energia" ?  6.0 :
           sector == "General"          ? 10.0 : custom_low

ref_high = sector == "Tecnologia"       ? 22.0 :
           sector == "Bancos / Energia" ? 10.0 :
           sector == "General"          ? 15.0 : custom_high

// ─── COLORES ──────────────────────────────────────────────────────────────────
color_ratio = na(ev_ebitda)          ? color.gray   :
              ev_ebitda < ref_low    ? color.green  :
              ev_ebitda <= ref_high  ? color.orange : color.red

// ─── PLOTS ────────────────────────────────────────────────────────────────────
p_low   = plot(ref_low,   "Mínimo referencia", color=color.new(color.green, 40),  linewidth=1, style=plot.style_line)
p_high  = plot(ref_high,  "Máximo referencia", color=color.new(color.red, 40),    linewidth=1, style=plot.style_line)
p_ratio = plot(ev_ebitda, "EV/EBITDA Ratio",   color=color_ratio,                 linewidth=2)

fill(p_low, p_high, color=color.new(color.green, 88), title="Zona razonable")

hline(0, "Cero", color=color.new(color.gray, 70), linestyle=hline.style_dotted)

// ─── TABLA INFORMATIVA ────────────────────────────────────────────────────────
if show_table and barstate.islast
    var table t = table.new(position.top_right, 2, 5,
         bgcolor=color.new(color.black, 75),
         border_width=1, border_color=color.new(color.gray, 50))

    hbg = color.new(color.purple, 55)

    status       = na(ev_ebitda)          ? "Sin datos" :
                   ev_ebitda < ref_low    ? "Barato"    :
                   ev_ebitda <= ref_high  ? "Razonable" : "Caro (Precaución)"
    status_color = na(ev_ebitda)          ? color.gray   :
                   ev_ebitda < ref_low    ? color.green  :
                   ev_ebitda <= ref_high  ? color.orange : color.red

    table.cell(t, 0, 0, "EV / EBITDA",  text_color=color.white, text_size=size.small, bgcolor=hbg)
    table.cell(t, 1, 0, na(ev_ebitda) ? "N/D" : str.tostring(math.round(ev_ebitda, 2)),
         text_color=color_ratio, text_size=size.small)

    table.cell(t, 0, 1, "EBITDA (TTM)",  text_color=color.white, text_size=size.small, bgcolor=hbg)
    table.cell(t, 1, 1, na(ebitda)  ? "N/D" : str.tostring(math.round(ebitda / 1e6, 2)) + "M",
         text_color=color.white, text_size=size.small)

    sector_label = sector_input == "Auto" ? "Auto (" + sector + ")" : sector
    table.cell(t, 0, 2, "Sector",     text_color=color.white, text_size=size.small, bgcolor=hbg)
    table.cell(t, 1, 2, sector_label, text_color=color.yellow, text_size=size.small)

    table.cell(t, 0, 3, "Rango sano", text_color=color.white, text_size=size.small, bgcolor=hbg)
    table.cell(t, 1, 3, str.tostring(ref_low) + " – " + str.tostring(ref_high),
         text_color=color.new(color.green, 20), text_size=size.small)

    table.cell(t, 0, 4, "Estado",     text_color=color.white, text_size=size.small, bgcolor=hbg)
    table.cell(t, 1, 4, status,       text_color=status_color, text_size=size.small)
